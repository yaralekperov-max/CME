# Database (Yandex Managed PostgreSQL)
DATABASE_URL="postgresql://user:password@host:6432/medcme?sslmode=require"

# Redis (Yandex Managed Redis)
REDIS_URL="redis://:password@host:6379"

# NextAuth
NEXTAUTH_URL="https://medcme.ru"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Claude API (Anthropic)
ANTHROPIC_API_KEY="sk-ant-..."

# Yandex Object Storage (S3-compatible)
S3_ENDPOINT="https://storage.yandexcloud.net"
S3_BUCKET="medcme-storage"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="ru-central1"

# SendPulse (Email)
SENDPULSE_CLIENT_ID=""
SENDPULSE_CLIENT_SECRET=""
SENDPULSE_FROM_EMAIL="no-reply@medcme.ru"
SENDPULSE_FROM_NAME="MedCME"

# App
NEXT_PUBLIC_APP_URL="https://medcme.ru"
NEXT_PUBLIC_APP_NAME="MedCME"

# Cron (pass as X-Cron-Secret header from your scheduler)
# Generate: openssl rand -hex 32
CRON_SECRET=""

# Sentry (error monitoring) — get DSN from sentry.io after creating project
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""        # your Sentry org slug
SENTRY_PROJECT=""    # your Sentry project slug
SENTRY_AUTH_TOKEN="" # for source map uploads (Settings → Auth Tokens)
